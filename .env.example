# Supabase project (Settings -> API). The anon key is safe for the browser ONLY
# because every table is protected by row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: enable the AI assistant buttons (requires the ai-assist edge function).
VITE_AI_ENABLED=false

# --- Server-side only (set with `supabase secrets set`, NEVER with a VITE_ prefix) ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001
